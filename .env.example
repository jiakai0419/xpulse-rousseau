PORT=3000
HOST=127.0.0.1

# X API user-context access.
# For V1, these can be copied from a manual OAuth flow or developer tooling.
X_USER_ID=
X_USER_ACCESS_TOKEN=

# X OAuth 2.0 Authorization Code with PKCE.
# The callback URL must exactly match the URL configured in the X Developer Console.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/api/auth/x/callback
X_OAUTH_SCOPES=tweet.read users.read offline.access

# OpenAI API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_SCORING_BATCH_SIZE=20
OPENAI_TRANSLATION_BATCH_SIZE=10
SELECTED_POST_COUNT=7
X_TIMELINE_PAGE_SIZE=100
X_TIMELINE_TARGET_POSTS=100
X_TIMELINE_MAX_PAGES=3
X_REQUEST_TIMEOUT_MS=30000
MEDIA_REQUEST_TIMEOUT_MS=120000

# Internal source id: "replay" means local replay from saved X runs; "x" means live authenticated X timeline.
TIMELINE_SOURCE=replay
