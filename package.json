{
  "name": "xpulse-rousseau",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "display:audit": "node scripts/display-fidelity-audit.mjs",
    "display:audit:auth": "DISPLAY_AUDIT_AUTH_PROFILE=1 node scripts/display-fidelity-audit.mjs",
    "display:audit:login": "node scripts/display-audit-login-unavailable.mjs",
    "display:inventory": "node --experimental-strip-types scripts/display-gap-inventory.ts",
    "display:oracle": "node scripts/display-oracle.mjs",
    "display:original-cache": "node scripts/display-original-evidence-cache.mjs",
    "display:regression": "node scripts/replay-display-regression.mjs",
    "display:rule-ledger": "node scripts/display-rule-ledger.mjs",
    "display:visual-review": "node scripts/display-visual-review.mjs",
    "doctor": "node scripts/doctor.mjs",
    "fresh:audit": "node scripts/fresh-pulse-audit.mjs",
    "render:coverage": "node scripts/render-coverage.mjs",
    "smoke": "node scripts/smoke.mjs",
    "stop": "node scripts/stop-server.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/unit/*.test.ts",
    "verify:refactor": "node scripts/verify-refactor.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
